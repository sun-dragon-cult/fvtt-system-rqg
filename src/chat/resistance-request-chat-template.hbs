<div class="rqg chat-card">
  {{#if castRoll}}
    {{> spellCastRollRow hiddenFromUuid=spellHiddenFromUuid casterUuid=spellCasterUuid}}
    {{#if resistanceFlavor}}
      <div class="resistance-request-flavor">{{{resistanceFlavor}}}</div>
    {{/if}}
  {{/if}}

  {{#if (eq state 'Requested')}}
    {{!-- "Resist" only reads as a choice next to Accept; alone it is just the roll. --}}
    <div class="flexrow gap1rem" data-only-owner-visible-uuid="{{targetTokenOrActorUuid}}">
      {{#if allowVoluntaryAccept}}
        <button class="resistance-request-roll"
                data-roll-resistance-request>{{localize "RQG.ChatMessage.ResistanceRequest.Resist"}}
        </button>
        <button class="resistance-request-accept"
                data-accept-resistance-request>{{localize "RQG.ChatMessage.ResistanceRequest.Accept"}}
        </button>
      {{else}}
        <button class="resistance-request-roll"
                data-roll-resistance-request>{{localize "RQG.ChatMessage.ResistanceRequest.Roll"}}
        </button>
      {{/if}}
    </div>
  {{else if (eq state 'Accepted')}}
    <p class="resistance-request-accepted">{{localize "RQG.ChatMessage.ResistanceRequest.AcceptedNotice"}}</p>
  {{else}}
    <span data-resistance-roll-html></span>
    {{#if outcomeDescription}}
      <div class="outcome-description">{{outcomeDescription}}</div>
    {{/if}}
  {{/if}}
</div>
