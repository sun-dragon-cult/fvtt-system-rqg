    "commonRuneMagicRqidLinks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rqid": {
            "type": "string",
            "default": ""
          },
          "name": {
            "type": "string",
            "default": ""
          },
          "bonus": {
            "type": [
              "integer",
              "null"
