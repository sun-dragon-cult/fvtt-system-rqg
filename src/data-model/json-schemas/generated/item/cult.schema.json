    "descriptionRqidLink": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "rqid": {
          "type": "string",
          "default": ""
        },
        "name": {
          "type": "string",
          "default": ""
        },
        "bonus": {
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "rqid",
        "name"
      ],
      "title": "Description",
      "description": "Link to the journal entry that describes the cult."
    },
    "runePoints": {
      "type": "object",
      "properties": {
        "value": {
          "type": [
            "integer",
            "null"
          ],
          "default": 0
        },
        "max": {
          "type": "integer",
          "default": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "max"
      ],
      "title": "Rune points",
      "description": "The cult's rune points. Value is the points the initiate currently holds."
    },
    "holyDays": {
      "type": "string",
      "default": "",
      "title": "Holy days",
      "description": "Free text listing the cult's holy days."
    },
    "gifts": {
      "type": "string",
      "default": "",
      "title": "Gifts",
      "description": "Free text listing the cult's gifts."
    },
    "geases": {
      "type": "string",
      "default": "",
      "title": "Geases",
      "description": "Free text listing the cult's geases."
    },
    "runeRqidLinks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rqid": {
            "type": "string",
            "default": ""
          },
          "name": {
            "type": "string",
            "default": ""
          },
          "bonus": {
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "rqid",
          "name"
        ]
      },
