<h2 class="magic-point-sources-heading">{{localize "RQG.Actor.Attributes.MagicPointSources"}}</h2>
<div class="magic-point-sources-list">
  {{#each rows}}
    <div class="magic-point-source-row" data-source-id="{{id}}">
      <span class="magic-point-source-handle grip-icon"></span>
      <span class="magic-point-source-priority">{{#if priority}}{{priority}}{{/if}}</span>
      <span class="magic-point-source-icon">
        {{#if img}}<img src="{{img}}">{{/if}}
      </span>
      <span class="magic-point-source-name">
        {{#if (eq kind "self")}}
          {{localize "RQG.Dialog.Common.MagicPointSourceOptions.Self"}}
        {{else}}
          {{name}}
        {{/if}}
        {{#if (eq kind "self")}}
          <span class="magic-point-source-rune-icon man"
                data-tooltip="{{localize "RQG.Dialog.Common.MagicPointSourceOptions.Self"}}"></span>
        {{else if (eq kind "ally")}}
          <span class="magic-point-source-rune-icon spirit"
                data-tooltip="{{localize "RQG.Actor.Attributes.MagicPointSourcesAlliedSpiritHint"}}"></span>
        {{else if (eq kind "boundSpirit")}}
          <span class="magic-point-source-rune-icon spirit"
                data-tooltip="{{localize "RQG.Actor.Attributes.MagicPointSourcesBoundSpiritHint"}}"></span>
          {{localize "RQG.Actor.Attributes.MagicPointSourcesInLabel"}}
          <img class="magic-point-source-item-icon" src="{{itemImg}}">
          {{itemName}}
        {{/if}}
      </span>
      <span class="magic-point-source-feed">
        {{#if feedMax}}
          <button type="button" class="magic-point-source-feed-button" data-action="feedFromSelf"
                  data-item-id="{{id}}"
                  title="{{localize 'RQG.Actor.Attributes.MagicPointSourcesFeedFromSelfHint' amount=feedMax}}">
            <i class="fa-solid fa-arrow-right-to-bracket"></i>
          </button>
        {{/if}}
      </span>
      {{#if (eq kind "self")}}
        <input type="number" min="0" max="99" size="2"
               name="system.attributes.magicPoints.value"
               value="{{value}}">
      {{else if (eq kind "ally")}}
        <input type="number" min="0" max="{{this.max}}" size="2"
               name="ally.system.attributes.magicPoints.value"
               value="{{value}}">
      {{else if (eq kind "boundSpirit")}}
        {{!-- ":" (not ".") separates {{id}} from the field path - a spirit's uuid contains ".". --}}
        <input type="number" min="0" max="{{this.max}}" size="2"
               name="{{id}}:system.attributes.magicPoints.value"
               value="{{value}}">
      {{else}}
        <input type="number" min="0" max="{{this.max}}" size="2"
               name="items.{{id}}.system.storedMagicPoints.value"
               value="{{value}}">
      {{/if}}
      <span class="magic-point-source-max">/ {{this.max}}</span>
    </div>
  {{/each}}
</div>
