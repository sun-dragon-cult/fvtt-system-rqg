{{#if areaTargets}}
  <span data-area-targets>{{areaTargets}}</span>
{{else}}
  {{#if targetOptions.length}}
    <select data-target-select aria-label="{{localize "RQG.Dialog.Common.Target"}}">
      {{selectOptions targetOptions selected=selectedTarget}}
    </select>
  {{else}}
    <span data-target-names>{{targetName}}</span>
  {{/if}}
  <span data-target-note class="{{targetNoteClass}}" {{#unless targetNote}}hidden{{/unless}}>{{targetNote}}</span>
{{/if}}
