<div class="rqg chat-card">
  <div class="flex-column gap03rem">
    <span data-attack-roll-html></span>
    <span data-defence-roll-html></span>
  </div>

  {{#if (eq attackState 'Attacked')}}
    <div class="flexrow">
      <button class="rqg-primary" data-only-owner-visible-uuid="{{defendingTokenOrActorUuid}}"
              data-defence><i class="fas fa-shield-halved" inert></i> {{localize "RQG.ChatMessage.Combat.Defend"}}
      </button>
    </div>
  {{else if (eq attackState 'Defended')}}
    <div class="outcome-description">{{{outcomeDescription}}}</div>
    {{!-- use presence of damageRoll as sign of there being damage to roll, should be null:ed if no damage is to be rolled --}}
    {{#if damageRoll}}
        {{#if (eq weaponDoingDamage "attackingWeapon")}}
        <button class="rqg-primary" data-roll-damage-and-hitlocation data-only-owner-visible-uuid="{{attackingTokenOrActorUuid}}">
          <i class="fas fa-dice" inert></i> {{localize "RQG.ChatMessage.Combat.RollDamageAndHitLocation"}}
        </button>
        {{else}}
          <button class="rqg-primary" data-roll-damage-and-hitlocation data-only-owner-visible-uuid="{{defendingTokenOrActorUuid}}">
            <i class="fas fa-dice" inert></i> {{localize "RQG.ChatMessage.Combat.RollDamage"}}
          </button>
        {{/if}}
    {{/if}}

  {{else if (eq attackState 'DamageRolled')}}
    <div class="outcome-description">{{{outcomeDescription}}}</div>
    <div class="flex-column gap05rem">
      <span data-damage-roll-html></span>
      {{#if (eq weaponDoingDamage "attackingWeapon")}}
        <span data-hit-location-roll-html></span>
      {{/if}}
      <div class="flex-row">
      {{#if defenderHitLocationDamage}}
      {{#unless actorDamagedApplied}}
        <button class="rqg-primary" data-apply-damage-to-actor data-only-owner-visible-uuid="{{defendingTokenOrActorUuid}}">
          <i class="fas fa-burst" inert></i> {{localize "RQG.ChatMessage.Combat.ApplyActorDamage"}}
        </button>
      {{/unless}}
      {{/if}}

      {{#if weaponDamage}}
      {{#unless weaponDamageApplied}}
        <button class="rqg-primary" data-apply-damage-to-weapon
          {{#if (eq weaponDoingDamage "attackingWeapon")}}
            data-only-owner-visible-uuid="{{defendingTokenOrActorUuid}}"
          {{else}}
            data-only-owner-visible-uuid="{{attackingTokenOrActorUuid}}"
          {{/if}}
          ><i class="fas fa-burst" inert></i> {{localize "RQG.ChatMessage.Combat.ApplyWeaponDamage"}}
        </button>
      {{/unless}}
      {{/if}}
      </div>
    </div>
  {{/if}}

  {{#if attackerFumbled}}
    <button class="rqg-primary" data-only-owner-visible-uuid="{{attackingTokenOrActorUuid}}"
            data-fumble="attacker"><i class="fas fa-dice" inert></i> {{localize "RQG.ChatMessage.Combat.RollAttackerFumble"}}
    </button>
  {{/if}}

  {{#if defenderFumbled}}
    <button class="rqg-primary" data-only-owner-visible-uuid="{{defendingTokenOrActorUuid}}"
            data-fumble="defender"><i class="fas fa-dice" inert></i> {{localize "RQG.ChatMessage.Combat.RollDefenderFumble"}}
    </button>
  {{/if}}

  {{#if attackerFumbleOutcome}}
    <b>{{localize "RQG.ChatMessage.Combat.AttackerFumble"}}:</b><br>
    {{{attackerFumbleOutcome}}}
  {{/if}}

  {{#if defenderFumbleOutcome}}
    <b>{{localize "RQG.ChatMessage.Combat.DefenderFumble"}}:</b><br>
    {{{defenderFumbleOutcome}}}
  {{/if}}
</div>

