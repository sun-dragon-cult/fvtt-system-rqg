<section class="tab skills-tab-v2{{#if (eq @root.activeTabs.primary "skills")}} active{{/if}}" data-group="primary" data-tab="skills">

  <div class="skill-filter-row">
    <div class="skill-filter-input">
      <i class="fas fa-magnifying-glass"></i>
      <input class="skill-filter" type="search" placeholder="{{localize 'RQG.Actor.Skill.FilterPlaceholder'}}">
    </div>
    {{#if enrichedUnspecifiedSkill}}<div class="specialization warning">{{{enrichedUnspecifiedSkill}}}</div>{{/if}}
  </div>

  <div class="masonry">
    {{#each embeddedItems.skill}}
    {{#if this}}
    <div class="masonry-item">
      <h2>{{localizeDynamic 'RQG.Actor.Skill.SkillCategory.' @key}}
        <span class="category-modifier">({{#with @root.system.skillCategoryModifiers}}{{lookup this @key}}{{/with}})</span>
      </h2>
      <div class="grid skill{{#edit-mode ../system.editMode 'all'}} skill-edit-mode{{/edit-mode}} item-list">
        {{#each this}}
        {{#unless system.runeRqidLinks.length}}
        <div class="skill-row">
          {{> actorSheetV2SkillRow}}
        </div>
        {{/unless}}
        {{/each}}
      </div>
    </div>
    {{/if}}
    {{/each}}
  </div>

</section>
