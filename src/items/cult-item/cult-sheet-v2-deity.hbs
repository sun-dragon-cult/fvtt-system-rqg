<div class="tab scrollable{{#if tab.active}} active{{/if}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
  <div class="key-value-grid fullheight" style="grid-template-rows: repeat(3, min-content) 1fr;">
    <label for="rune-points-value-{{id}}">{{localize "RQG.Item.Cult.RunePoints"}}</label>
    <div>
      <input
        id="rune-points-value-{{id}}"
        name="system.runePoints.value"
        value="{{system.runePoints.value}}"
        type="number"
        min="0"
        max="99"
      /> / <input
      id="rune-points-max-{{id}}"
      name="system.runePoints.max"
      value="{{system.runePoints.max}}"
      type="number"
      min="0"
      max="99"
    />
    </div>

    <label for="runes-{{id}}" {{#unless system.runeRqidLinks.length}}class="warning" data-tooltip="{{localize 'RQG.Item.Cult.Notification.NoRunesWarn'}}"{{/unless}}>{{localize "RQG.Item.Cult.Runes"}}</label>
    <div {{#unless system.runeRqidLinks.length}}class="warning" data-tooltip="{{localize 'RQG.Item.Cult.Notification.NoRunesWarn'}}"{{/unless}}>
      <rqg-link-field
        name="system.runeRqidLinks"
        value="{{json system.runeRqidLinks}}"
        documents="Item"
        types="rune"
        allow-duplicates
        hint="RQG.Foundry.ContentLink.Field.Empty.Rune"
        owner="{{@root.uuid}}"
      >
        {{selectOptions allRuneOptions localize=false}}
      </rqg-link-field>
    </div>

    <label>{{localize "RQG.Item.Cult.CommonRuneMagic"}}</label>
    <rqg-link-field
      name="system.commonRuneMagicRqidLinks"
      value="{{json system.commonRuneMagicRqidLinks}}"
      documents="Item"
      types="runeMagic"
      hint="RQG.Foundry.ContentLink.Field.Empty.RuneMagic"
      owner="{{@root.uuid}}"
    ></rqg-link-field>

    <label class="editor-label">{{localize "RQG.Item.Cult.HolyDays"}}</label>
    <div class="editor-container">
      <prose-mirror name="system.holyDays" value="{{system.holyDays}}" toggled {{disabled (not isEditable)}} data-document-uuid="{{uuid}}" class="self-stretch">{{{enrichedHolyDays}}}</prose-mirror>
    </div>
  </div>
</div>
