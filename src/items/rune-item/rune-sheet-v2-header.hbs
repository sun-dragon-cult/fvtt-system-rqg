<header class="item-sheet-header">
  <img src="{{img}}" data-action="editImage" data-edit="img" data-tooltip="{{name}}">

  <div class="flex-column gap03rem">
    <div class="property-line">

      <div class="label-above long">
        <label for="rune-{{id}}">{{localize "RQG.Item.Rune.Name"}}</label>
        <input type="text" id="rune-{{id}}" name="system.rune" value="{{system.rune}}" />
      </div>

      <div class="label-above parens">
        <label for="rune-type-{{id}}">{{localize "RQG.Item.Rune.Type"}}</label>
        <div class="nowrap">
          (
          <select id="rune-type-{{id}}" name="system.runeType">
            {{selectOptions runeTypeOption selected=system.runeType localize=false}}
          </select>
          )
        </div>
      </div>
    </div>

    <rqg-link-field
      name="system.descriptionRqidLink"
      value="{{json system.descriptionRqidLink}}"
      single
      documents="JournalEntry,JournalEntryPage"
      hint="RQG.Foundry.ContentLink.Field.Empty.Journal"
      owner="{{@root.uuid}}"
    ></rqg-link-field>
  </div>
</header>
