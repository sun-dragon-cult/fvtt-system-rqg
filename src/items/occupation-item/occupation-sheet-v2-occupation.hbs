<div class="tab scrollable{{#if tab.active}} active{{/if}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">

  <div class="key-value-grid">

    <label>{{localize "RQG.Item.Occupation.Homelands"}}</label>
    <rqg-link-field
      name="system.homelandRqidLinks"
      value="{{json system.homelandRqidLinks}}"
      documents="Item"
      types="homeland"
      hint="RQG.Item.Occupation.AllHomelands"
      owner="{{@root.uuid}}"
    ></rqg-link-field>

    <label>{{localize "RQG.Item.Occupation.OccupationalSkillLinks"}}</label>
    <rqg-link-field
      class="occupational-skills"
      name="system.occupationalSkills"
      value="{{json system.occupationalSkills}}"
      link-key="skillRqidLink"
      documents="Item"
      types="skill"
      allow-duplicates
      bonus
      hint="RQG.Foundry.ContentLink.Field.Empty.Skill"
      owner="{{@root.uuid}}"
    ></rqg-link-field>

    <label for="standard-of-living-{{id}}">{{localize "RQG.Item.Occupation.StandardOfLiving"}}</label>
    <select id="standard-of-living-{{id}}" name="system.standardOfLiving">
      {{selectOptions standardsOfLivingOptions selected=system.standardOfLiving localize=true}}
    </select>

    <label for="base-income-{{id}}">{{localize "RQG.Item.Occupation.BaseIncome"}}</label>
    <div>
      <input type="number" id="base-income-{{id}}" name="system.baseIncome" min="0"
             value="{{system.baseIncome}}">
      &nbsp;
      {{localize "RQG.Item.Gear.LunarsAbbr"}}
    </div>

    <label for="base-income-notes-{{id}}">{{localize "RQG.Item.Occupation.BaseIncomeNotes"}}</label>
    <input type="text" id="base-income-notes-{{id}}" name="system.baseIncomeNotes"
           value="{{system.baseIncomeNotes}}">

    <label>{{localize "RQG.Item.Occupation.CultLinks"}}</label>
    <rqg-link-field
      name="system.cultRqidLinks"
      value="{{json system.cultRqidLinks}}"
      documents="Item"
      types="cult"
      hint="RQG.Foundry.ContentLink.Field.Empty.Cult"
      owner="{{@root.uuid}}"
    ></rqg-link-field>

    <label for="ransom-{{id}}">{{localize "RQG.Item.Occupation.Ransom"}}</label>
    <div>
      <input type="number" id="ransom-{{id}}" name="system.ransom" min="0" value="{{system.ransom}}">
      &nbsp;
      {{localize "RQG.Item.Gear.LunarsAbbr"}}
    </div>

    <label>{{localize "RQG.Item.Occupation.StartingEquipmentLinks"}}</label>
    <rqg-link-field
      name="system.startingEquipmentRqidLinks"
      value="{{json system.startingEquipmentRqidLinks}}"
      documents="Item"
      types="armor,gear,weapon"
      hint="RQG.Foundry.ContentLink.Field.Empty.Equipment"
      owner="{{@root.uuid}}"
    ></rqg-link-field>
  </div>
</div>
