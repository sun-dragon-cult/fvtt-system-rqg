<header class="item-sheet-header">
  <img src="{{img}}" data-action="editImage" data-edit="img" data-tooltip="{{name}}" />

  <div class="flex-column gap03rem">

    <div class="property-line">
      <div class="label-above">
        <label for="occupation-{{id}}">{{localize "RQG.Item.Occupation.Occupation"}}</label>
        <input
          id="occupation-{{id}}"
          name="system.occupation"
          value="{{system.occupation}}"
          type="text"
        >
      </div>

      <div class="label-above">
        <label for="region-{{id}}">{{localize "RQG.Item.Occupation.Specialization"}}</label>
        <div>
          ( <input type="text" id="region-{{id}}" name="system.specialization"
                   value="{{system.specialization}}"> )
        </div>
      </div>
    </div>


    <rqg-link-field
      name="system.occupationRqidLink"
      value="{{json system.occupationRqidLink}}"
      single
      documents="JournalEntry,JournalEntryPage"
      hint="RQG.Foundry.ContentLink.Field.Empty.Journal"
      owner="{{@root.uuid}}"
    ></rqg-link-field>
  </div>

</header>
