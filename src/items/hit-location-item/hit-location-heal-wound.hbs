<div class="wound-dialog heal-wound-dialog">
  {{#if free}}
    <div class="heal-mode-segmented" role="radiogroup" aria-label="{{localize "RQG.Item.HitLocation.HealWound.HealModeLabel"}}">
      <input type="radio" id="heal-mode-single-{{dialogId}}" name="healMode" value="single" checked />
      <label for="heal-mode-single-{{dialogId}}">{{localize "RQG.Item.HitLocation.HealWound.HealModeSingle"}}</label>
      <input type="radio" id="heal-mode-all-{{dialogId}}" name="healMode" value="all" />
      <label for="heal-mode-all-{{dialogId}}">{{localize "RQG.Item.HitLocation.HealWound.HealModeAll"}}</label>
    </div>

    <div id="healPointsSection" class="heal-points-section">
      <label class="wound-dialog-label">
        {{localize "RQG.Item.HitLocation.HealWound.HitPointsToHeal"}}
      </label>
      <div class="form-fields">
        <range-picker name="heal" value={{heal}} min="1" max="{{maxHeal}}" step="1"></range-picker>
      </div>
    </div>
  {{else}}
    <div class="wound-dialog-label">{{localize "RQG.Item.HitLocation.HealWound.PointsToHeal" points=points}}</div>
  {{/if}}

  <div class="heal-locations" id="healWoundOptions">
    {{#each locations}}
      <fieldset class="heal-location">
        <legend>{{localize "RQG.Item.HitLocation.HealWound.LocationHitPoints" hitLocationName=name value=hpValue max=hpMax}}{{#if severed}} – {{localize "RQG.Item.HitLocation.HealthStatusEnum.severed"}}{{/if}}</legend>
        <div class="woundlist wound-dialog-wounds">
          {{#each wounds}}
            {{#if @root.split}}
              <div class="wound-dialog-split-wound">
                <div class="wound-dialog-wound-option" data-wound-key="{{key}}">
                  <i class="fas fa-burst wound-dialog-wound-burst" aria-hidden="true"></i>
                  <span class="wound-dialog-wound-value">{{value}}</span>
                </div>
                <input type="number" name="points-{{key}}" value="{{preset}}" min="0" max="{{value}}" step="1"
                       aria-label="{{localize "RQG.Item.HitLocation.HealWound.PointsOnWound" damage=value hitLocationName=../name}}" />
              </div>
            {{else}}
              <label class="wound-dialog-wound-option" data-wound-key="{{key}}"
                     data-tooltip="{{localize "RQG.Item.HitLocation.HealWound.PointsOnWound" damage=value hitLocationName=../name}}">
                <input type="radio" name="wound" value="{{key}}" {{checked (eq key @root.selectedKey)}} />
                <i class="fas fa-burst wound-dialog-wound-burst" aria-hidden="true"></i>
                <span class="wound-dialog-wound-value">{{value}}</span>
              </label>
            {{/if}}
          {{/each}}
          {{#if restoreKey}}
            <label class="wound-dialog-wound-option wound-dialog-restore" data-wound-key="{{restoreKey}}"
                   data-tooltip="{{localize "RQG.Item.HitLocation.HealWound.RestoreSevered"}}">
              <input type="radio" name="wound" value="{{restoreKey}}" {{checked (eq restoreKey @root.selectedKey)}}
                     aria-label="{{localize "RQG.Item.HitLocation.HealWound.RestoreSevered"}}" />
              <i class="fas fa-hand-holding-medical wound-dialog-wound-burst" aria-hidden="true"></i>
            </label>
          {{/if}}
        </div>
      </fieldset>
    {{/each}}
  </div>

  {{#if split}}
    <div class="heal-budget" data-heal-budget></div>
  {{/if}}
  <div class="heal-feedback" aria-live="polite">{{healFeedback}}</div>
</div>
