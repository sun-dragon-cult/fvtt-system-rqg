<div class="tab scrollable{{#if tab.active}} active{{/if}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">

  <div class="key-value-grid">

    <label>{{localize "RQG.Item.Homeland.CultureJournalEntries"}}</label>
    <rqg-link-field
      name="system.cultureJournalRqidLinks"
      value="{{json system.cultureJournalRqidLinks}}"
      documents="JournalEntry,JournalEntryPage"
      hint="RQG.Foundry.ContentLink.Field.Empty.Journal"
      owner="{{@root.uuid}}"
    ></rqg-link-field>

    <label>{{localize "RQG.Item.Homeland.TribeJournalEntries"}}</label>
    <rqg-link-field
      name="system.tribeJournalRqidLinks"
      value="{{json system.tribeJournalRqidLinks}}"
      documents="JournalEntry,JournalEntryPage"
      hint="RQG.Foundry.ContentLink.Field.Empty.Journal"
      owner="{{@root.uuid}}"
    ></rqg-link-field>

    <label>{{localize "RQG.Item.Homeland.ClanJournalEntries"}}</label>
    <rqg-link-field
      name="system.clanJournalRqidLinks"
      value="{{json system.clanJournalRqidLinks}}"
      documents="JournalEntry,JournalEntryPage"
      hint="RQG.Foundry.ContentLink.Field.Empty.Journal"
      owner="{{@root.uuid}}"
    ></rqg-link-field>

    <label>{{localize "RQG.Item.Homeland.CultLinks"}}</label>
    <rqg-link-field
      name="system.cultRqidLinks"
      value="{{json system.cultRqidLinks}}"
      documents="Item"
      types="cult"
      hint="RQG.Foundry.ContentLink.Field.Empty.Cult"
      owner="{{@root.uuid}}"
    ></rqg-link-field>

    <label>{{localize "RQG.Item.Homeland.SkillLinks"}}</label>
    <rqg-link-field
      name="system.skillRqidLinks"
      value="{{json system.skillRqidLinks}}"
      documents="Item"
      types="skill"
      bonus
      hint="RQG.Foundry.ContentLink.Field.Empty.Skill"
      owner="{{@root.uuid}}"
    ></rqg-link-field>

    <label>{{localize "RQG.Item.Homeland.RuneLinks"}}</label>
    <rqg-link-field
      name="system.runeRqidLinks"
      value="{{json system.runeRqidLinks}}"
      documents="Item"
      types="rune"
      hint="RQG.Foundry.ContentLink.Field.Empty.Rune"
      owner="{{@root.uuid}}"
    >
      {{selectOptions allRuneOptions localize=false}}
    </rqg-link-field>

    <label>{{localize "RQG.Item.Homeland.PassionLinks"}}</label>
    <rqg-link-field
      name="system.passionRqidLinks"
      value="{{json system.passionRqidLinks}}"
      documents="Item"
      types="passion"
      hint="RQG.Foundry.ContentLink.Field.Empty.Passion"
      owner="{{@root.uuid}}"
    ></rqg-link-field>
  </div>
</div>
