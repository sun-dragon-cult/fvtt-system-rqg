<label for="encumbrance-{{id}}">{{localize "RQG.Item.Gear.EncumbranceAbbrEach"}}</label>
<input id="encumbrance-{{id}}"
       type="number"
       name="system.encumbrance"
       value="{{system.encumbrance}}"
       min="0"
       max="999999"
>

<label for="encumbrance-total-{{id}}">{{localize "RQG.Item.Gear.EncumbranceAbbrTotal"}}</label>
<input id="encumbrance-total-{{id}}" 
       type="text"
       value="{{decimalMultiply system.quantity system.encumbrance}}"
       readonly
       tabindex="-1"
>

<label for="equipped-status-{{id}}">{{localize "RQG.Item.Gear.EquippedStatus"}}</label>
<select id="equipped-status-{{id}}" name="system.equippedStatus">
  {{selectOptions equippedStatusOptions selected=system.equippedStatus localize=true}}
</select>

{{#if isGM}}
  <label for="price-real-{{id}}">{{localize "RQG.Item.Gear.PriceReal"}}</label>
  <div>
    <input id="price-real-{{id}}"
           type="number"
           name="system.price.real"
           value="{{system.price.real}}"
           min="0"
           max="99999999">
    {{localize "RQG.Item.Gear.LunarsAbbr"}}
  </div>
{{/if}}

<label for="price-estimated-{{id}}">{{localize "RQG.Item.Gear.PriceEstimated"}}</label>
<div>
  <input id="price-estimated-{{id}}"
         type="number"
         name="system.price.estimated"
         value="{{system.price.estimated}}"
         min="0"
         max="99999999">
  {{localize "RQG.Item.Gear.LunarsAbbr"}}
</div>

<label for="location-{{id}}">{{localize "RQG.Item.Gear.Location"}}</label>
<input id="location-{{id}}"
       type="text"
       name="system.location"
       value="{{system.location}}">

{{#if isGM}}
  <label for="attuned-to-{{id}}">{{localize "RQG.Item.Gear.AttunedTo"}}</label>
  <input id="attuned-to-{{id}}"
         type="text"
         name="system.attunedTo"
         value="{{system.attunedTo}}">
{{/if}}

{{#if isGM}}
  <label for="stored-magic-points-identified-{{id}}">
    {{localize "RQG.Item.Gear.StoredMagicPointsIdentified"}}
  </label>
  <input id="stored-magic-points-identified-{{id}}"
         type="checkbox"
         name="system.storedMagicPoints.identified"
         {{checked system.storedMagicPoints.identified}}>
{{/if}}

{{#if (or isGM system.storedMagicPoints.identified)}}
  <label for="stored-magic-points-value-{{id}}">{{localize "RQG.Item.Gear.StoredMagicPoints"}}</label>
  <div>
    <input id="stored-magic-points-value-{{id}}"
           type="number"
           name="system.storedMagicPoints.value"
           value="{{system.storedMagicPoints.value}}"
           min="0"
           max="99">
    / <input id="stored-magic-points-max-{{id}}"
             type="number"
             name="system.storedMagicPoints.max"
             value="{{system.storedMagicPoints.max}}"
             min="0"
             max="99">
  </div>
{{/if}}

{{!-- Bound Spirit(s) (#999) - unlike storedMagicPoints above, never gated behind isGM/identified.
     A list, not a single link: an item can hold more than one; the dropzone always appends. --}}
<label for="bound-spirit-{{id}}">{{localize "RQG.Item.Gear.BoundSpirit"}}</label>
<div id="bound-spirit-{{id}}"
     class="bound-spirit-list"
     data-bound-spirit-dropzone
     data-tooltip="{{localize "RQG.Item.Gear.BoundSpiritDropHint"}}">
  {{#each boundSpiritActors}}
    <div class="bond-actor-link bound-spirit-link">
      {{toAnchor uuid}}
      {{#if ../isEditable}}
        <a data-action="unlinkBoundSpirit" data-unlink-bound-spirit-uuid="{{uuid}}"
           data-tooltip="{{localize "RQG.Item.Gear.UnlinkBoundSpiritTitle" spiritName=name}}">
          <i class="fas fa-unlink"></i>
        </a>
      {{/if}}
    </div>
  {{/each}}
  {{#unless boundSpiritActors.length}}
    <div class="bond-actor-link bound-spirit-link empty">
      <span class="bound-spirit-hint">{{localize "RQG.Item.Gear.BoundSpiritDropHint"}}</span>
    </div>
  {{/unless}}
</div>

{{!-- Matrix Spell(s) (Core p.264-265, #959) - a list, not a single link, like Bound Spirit(s)
     above: an item can hold more than one enchanted spell (e.g. one 4-point and one 1-point
     spell), and the dropzone always appends another. Each spell's own mechanics are resolved live
     from spellRqidLink at cast time (resolveMatrixSpellItem, spell-matrix.ts); only the enchanted
     level (points) is stored per entry here. Listed alphabetically - use `this.storageIndex`,
     not `@index`, for the real array position. --}}
<label for="matrix-spell-{{id}}">{{localize "RQG.Item.Gear.MatrixSpell"}}</label>
<div id="matrix-spell-{{id}}"
     class="matrix-spell-dropzone"
     data-matrix-spell-dropzone
     data-tooltip="{{localize "RQG.Item.Gear.MatrixSpellDropHint"}}">
  {{#each system.matrixSpells}}
    <div class="bond-actor-link matrix-spell-link">
      <span data-rqid-link="{{this.spellRqidLink.rqid}}">
        {{this.spellRqidLink.name}}
      </span>
      {{#if ../isGM}}
        {{#if this.isVariable}}
          <input type="number"
                 data-matrix-spell-points
                 data-index="{{this.storageIndex}}"
                 data-tooltip="{{localize "RQG.Item.Gear.MatrixSpellPoints"}}"
                 value="{{this.points}}"
                 min="0"
                 max="99">
        {{else}}
          <span class="matrix-spell-points-readonly"
                data-tooltip="{{localize "RQG.Item.Gear.MatrixSpellPoints"}}">{{this.points}}</span>
        {{/if}}
      {{/if}}
      {{#if ../isEditable}}
        <a data-action="unlinkMatrixSpell"
           data-index="{{this.storageIndex}}"
           data-tooltip="{{localize "RQG.Item.Gear.UnlinkMatrixSpellTitle" spellName=this.spellRqidLink.name}}">
          <i class="fas fa-unlink"></i>
        </a>
      {{/if}}
    </div>
  {{/each}}
  {{#unless system.matrixSpells.length}}
    <div class="bond-actor-link matrix-spell-link empty">
      <span class="matrix-spell-hint">{{localize "RQG.Item.Gear.MatrixSpellDropHint"}}</span>
    </div>
  {{/unless}}
</div>
