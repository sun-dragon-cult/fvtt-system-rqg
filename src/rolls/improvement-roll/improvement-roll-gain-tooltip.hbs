<div class="dice-tooltip" data-only-owner-visible-uuid="{{speakerUuid}}">
  <div class="roll-formula">
    <b>{{{formulaHtml}}}</b>
  </div>
  {{#each parts}}
    <section class="tooltip-part">
      <div class="dice">
        <header class="part-header flexrow gap03rem flex-align-center">
          <ol class="dice-rolls">
            {{#each this.rolls}}
              <li class="roll {{this.classes}}">{{{this.result}}}</li>
            {{/each}}
          </ol>
          <span class="part-formula">{{this.formula}}</span>
          <span class="part-total">{{this.total}}</span>
        </header>
      </div>
    </section>
  {{/each}}
</div>
